  <ItemGroup>
    <ProjectReference Include="..\..\services\campfit-core-api\CampFit.Core.Api.csproj" />
    <ProjectReference Include="..\..\services\campfit-adventure\CampFit.Adventure.Api.csproj" />
    <ProjectReference Include="..\..\services\campfit-bff-mobile\CampFit.Bff.Mobile.csproj" />
  </ItemGroup>
</Project>
