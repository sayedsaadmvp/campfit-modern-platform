{
  "Azure": {
    "SubscriptionId": "<subscription-id>",
    "ResourceGroup": "<resource-group>",
    "Location": "eastus",
    "ContainerAppsEnvironment": "<environment-name>",
    "ContainerRegistryName": "<acr-name>",
    "ContainerRegistryLoginServer": "<acr-name>.azurecr.io",
    "KeyVaultName": "<key-vault-name>",
    "KeyVaultUri": "https://<key-vault-name>.vault.azure.net/",
    "UserAssignedIdentityName": "<identity-name>",
    "UserAssignedIdentityClientId": "<client-id>",
    "UserAssignedIdentityResourceId": "<resource-id>",
    "PostgresHost": "<server>.postgres.database.azure.com",
    "PostgresPort": 5432
  },
  "Images": {
    "Core": "<acr-name>.azurecr.io/campfit-core-api:<full-git-sha>",
    "Adventure": "<acr-name>.azurecr.io/campfit-adventure:<full-git-sha>",
    "Bff": "<acr-name>.azurecr.io/campfit-bff-mobile:<full-git-sha>",
    "Analytics": "<acr-name>.azurecr.io/analytics-read-service:<full-git-sha>"
  },
  "BffAllowedCorsOrigin": "https://app.campfit.com"
}
